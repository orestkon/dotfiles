# ==============================================================================
# LAZY-LOADED NVM (NODE VERSION MANAGER)
# ==============================================================================
lazy_nvm() {
  unset -f nvm node npm npx yarn pnpm 2>/dev/null
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
}

nvm() { lazy_nvm; nvm "$@"; }
node() { lazy_nvm; node "$@"; }
npm() { lazy_nvm; npm "$@"; }
npx() { lazy_nvm; npx "$@"; }
yarn() { lazy_nvm; yarn "$@"; }
pnpm() { lazy_nvm; pnpm "$@"; }
