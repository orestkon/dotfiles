[include]
  path = ~/.secrets/gitconfig
  path = ~/dotfiles/git/delta/catppuccin.gitconfig

[init]
	defaultBranch = main

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
    features = catppuccin-macchiato
    side-by-side = true
    line-numbers = true
    navigate = true
    true-color = always
