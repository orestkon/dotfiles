{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "default_agent": "plan",
  "providers": {
    "deepseek": {
      "settings": {
        "apiKey": "{file:~/.secrets/deepseek-key-opencode}"
      }
    }
  },
  "permissions": [
    { "action": "read", "resource": "~/.secrets/*", "effect": "deny" },
    { "action": "read", "resource": "*/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },

    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.opencode/plan/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/Documents/Obsidian Vault/*", "effect": "allow" },
    { "action": "read", "resource": "~/Documents/Obsidian Vault/*", "effect": "allow" },

    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": ".git/*", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.p12", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "edit", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "edit", "resource": "~/Documents/Obsidian Vault/*", "effect": "deny" },

    { "action": "shell", "resource": "*", "effect": "allow" },

    { "action": "shell", "resource": "* /*", "effect": "ask" },
    { "action": "shell", "resource": "* ~/*", "effect": "ask" },
    { "action": "shell", "resource": "* $HOME/*", "effect": "ask" },
    { "action": "shell", "resource": "* ../*", "effect": "ask" },
    { "action": "shell", "resource": "*--output*", "effect": "ask" },
    { "action": "shell", "resource": "*>/*", "effect": "ask" },

    { "action": "shell", "resource": "*.env*", "effect": "ask" },
    { "action": "shell", "resource": "*id_rsa*", "effect": "ask" },
    { "action": "shell", "resource": "*id_ed25519*", "effect": "ask" },
    { "action": "shell", "resource": "*.pem*", "effect": "ask" },
    { "action": "shell", "resource": "*.p12*", "effect": "ask" },

    { "action": "shell", "resource": "stow *", "effect": "ask" },
    { "action": "shell", "resource": "git config --global *", "effect": "ask" },
    { "action": "shell", "resource": "brew install *", "effect": "ask" },
    { "action": "shell", "resource": "brew uninstall *", "effect": "ask" },
    { "action": "shell", "resource": "brew upgrade *", "effect": "ask" },
    { "action": "shell", "resource": "brew reinstall *", "effect": "ask" },
    { "action": "shell", "resource": "brew bundle *", "effect": "ask" },
    { "action": "shell", "resource": "npm install -g *", "effect": "ask" },
    { "action": "shell", "resource": "npm i -g *", "effect": "ask" },
    { "action": "shell", "resource": "npm uninstall -g *", "effect": "ask" },
    { "action": "shell", "resource": "npm update -g *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm add -g *", "effect": "ask" },
    { "action": "shell", "resource": "yarn global add *", "effect": "ask" },
    { "action": "shell", "resource": "bun add -g *", "effect": "ask" },
    { "action": "shell", "resource": "bun remove -g *", "effect": "ask" },
    { "action": "shell", "resource": "cargo install *", "effect": "ask" },
    { "action": "shell", "resource": "cargo uninstall *", "effect": "ask" },
    { "action": "shell", "resource": "rustup update *", "effect": "ask" },
    { "action": "shell", "resource": "rustup toolchain install *", "effect": "ask" },
    { "action": "shell", "resource": "rustup toolchain uninstall *", "effect": "ask" },
    { "action": "shell", "resource": "rustup component add *", "effect": "ask" },
    { "action": "shell", "resource": "rustup component remove *", "effect": "ask" },
    { "action": "shell", "resource": "rustup default *", "effect": "ask" },
    { "action": "shell", "resource": "rustup override *", "effect": "ask" },
    { "action": "shell", "resource": "pip install *", "effect": "ask" },
    { "action": "shell", "resource": "pip3 install *", "effect": "ask" },
    { "action": "shell", "resource": "python -m pip install *", "effect": "ask" },
    { "action": "shell", "resource": "python3 -m pip install *", "effect": "ask" },
    { "action": "shell", "resource": "gem install *", "effect": "ask" },
    { "action": "shell", "resource": "go install *", "effect": "ask" },
    { "action": "shell", "resource": "dotnet tool install *", "effect": "ask" },

    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean -*", "effect": "ask" },
    { "action": "shell", "resource": "git checkout -- *", "effect": "ask" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "git stash drop *", "effect": "ask" },
    { "action": "shell", "resource": "git stash clear", "effect": "ask" },
    { "action": "shell", "resource": "git filter-branch *", "effect": "ask" },
    { "action": "shell", "resource": "rm -* *", "effect": "ask" },

    { "action": "shell", "resource": "*~/.secrets*", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git -C * push *", "effect": "deny" },
    { "action": "shell", "resource": "git -c * push *", "effect": "deny" },
    { "action": "shell", "resource": "git --git-dir * push *", "effect": "deny" },
    { "action": "shell", "resource": "git --git-dir=* push *", "effect": "deny" },
    { "action": "shell", "resource": "git lfs push *", "effect": "deny" },
    { "action": "shell", "resource": "git -C * lfs push *", "effect": "deny" },
    { "action": "shell", "resource": "git send-pack *", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" }
  ],
  "policies": [
    { "action": "tool.use", "resource": "shell:git push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git -C * push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git -c * push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git --git-dir * push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git --git-dir=* push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git lfs push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git -C * lfs push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git send-pack *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:sudo *", "effect": "deny" }
  ]
}
